# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Allow test files inside source packages and generated-projects
!packages/yamltecture/test/*.test.ts
!packages/**/__tests__/*.test.ts
!packages/**/__tests__/*.spec.ts
!generated-projects/**/*.test.ts
!generated-projects/**/*.spec.ts

# ...and the E2E suites, which are the repository's own tests. The blanket
# `*.spec.ts` above is aimed at spec files inside generated output; without this
# negation a suite written under tests/ is silently never committed, which is
# exactly what happened to `tests/e2e/wasm/` — playwright.config.ts landed and
# the two specs beside it did not.
!tests/**/*.e2e.spec.ts
!tests/**/*.spec.ts
# The rule and workflow editors' own suite lives in scripts/, and its specs were
# never committed for the same reason: `bun run test:e2e:rules-workflows` found
# a config and no tests.
!scripts/e2e-rules-workflows/specs/*.spec.ts

# Generated projects runtime artifacts
packages/web/generated-projects/
packages/generator/generated-projects/
generated-projects/*
generated-app/
run-logs/

# Test + build artifacts. These are bundled output — linting or reviewing them
# says nothing about the source, and playwright-report/index.html alone carried
# 1380 lint diagnostics from its inlined bundle.
playwright-report/
test-results/

# Production
dist/
build/
.next/
out/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
appwithai-mastra.db*
database/appwithai.db/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
.vscode
.idea

# Misc
.turbo
.vercel
.cache
temp/
tmp/

# Generated
generated/
output/
test-output/
*.mermaid
*.generated.*
.gstack/
.playwright-mcp/

# Checker report artifacts — rewritten on every generate
*.eml.mmd.error
docker/ca-certificates/*.crt

# Generated CRM reference application — the source is committed on purpose (it
# is the worked example for common/language/examples/crm.eml.mmd), but never its
# dependencies, build output or lockfile.

# PGlite vendored beside the guide by `bun run vendor:pglite` — 17MB of
# WebAssembly, put there by that script rather than committed. Never a CDN.
html/assets/vendor/

# The WASM stack's inlined assets are generated, and are committed anyway.
# They are what the generator actually reads — a browser has no `fs.readFile` —
# so a checkout without them produces applications with no runtime and an
# overlay with nothing to apply. CI keeps them honest by regenerating and
# diffing (`bun run build:wasm-runtime -- --check`).
#
# Named individually rather than as `!**/*.generated.ts`: the blanket form would
# quietly start committing every generated file anyone adds later, which is the
# opposite of what the rule above it is for.
!packages/generator/src/generators/wasm/runtime-assets.generated.ts
!packages/generator/src/generators/wasm/overlay-assets.generated.ts

# Written by the audit-ledger test when it stubs the Nest decorators.
packages/generator/templates/wasm-overlay/backend/src/modules/audit/__stub.ts
packages/generator/templates/wasm-overlay/backend/src/modules/audit/__under-test.ts
packages/generator/src/generators/wasm/__tests__/.tmp/

# Screenshots the wasm E2E suite captures on every run. Regenerated by
# `bun run test:wasm`; the ones worth keeping are copied into docs/qa.
pics/wasm-e2e/

# The NestJS stack's templates, copied beside the hosted page by
# `bun run build:stack-templates`. A second copy of files already in this
# repository — regenerate it rather than commit it.
html/assets/stack-templates.json
pics/

# Tool and build output that was committed once and should not be again.
# `graphify-out/` is a dependency-graph report, `.understand-anything/` a code
# scan, `.mastra/` Mastra's bundler output, and `.pids/` the pid files a local
# run leaves behind — including, until recently, ones naming stacks the
# generator stopped emitting years ago.
.mastra/
.pids/
graphify-out/
.understand-anything/

# A per-developer profile for a local model endpoint. Personal tooling.
.openclaude-profile.json

# Local runtime pid file
.appwithai-web.pid
language.zip

# The rule and workflow editors are vendored from packages/editors/src at generation time.
packages/generator/templates/tanstack-start-nestjs/frontend/src/editors/
scripts/e2e-rules-workflows/screenshots/

# TypeScript incremental-build caches. Every package builds with `bun build`;
# nothing reads these, and a committed one records whatever toolchain wrote it.
*.tsbuildinfo

