import { defineConfig } from '@tanstack/start/config'
import path from 'path'

export default defineConfig({
  // node-server, which is the default, and deliberately kept rather than the
  // `bun` preset even though bun is what runs the result.
  //
  // The two build differently because they resolve packages differently: bun
  // honours a `bun` export condition that node ignores, so each preset copies
  // the files its own runtime would ask for and leaves the other's behind. The
  // node build under bun cannot load `jose` (whose `bun` condition points at a
  // build the node trace omits), which is what stops `@copilotkit/runtime`
  // loading and takes the assistant with it. But the bun build cannot resolve
  // `react-dom/server`, which is every page in the application — a much worse
  // trade, so the assistant is the one that loses.
  //
  // Running the built server under node fixes both; the images do not carry a
  // node runtime today. Set SERVER_PRESET to deploy elsewhere.
  server: {
    preset: process.env.SERVER_PRESET || 'node-server',
  },
  tsr: {
    appDirectory: 'src',
    routesDirectory: 'src/routes',
    generatedRouteTree: 'src/routeTree.gen.ts',
    quoteStyle: 'single',
    semicolons: false,
  },
  react: {
    jsxRuntime: 'automatic',
    jsxImportSource: 'react',
  },
  vite: {
    optimizeDeps: {
      // Scan every route file at startup. Vite's default is to scan only the
      // entry file, so a first visit to any page (e.g. /dashboard) triggers a
      // new dep-discovery pass, forces a full reload mid-navigation and
      // interrupts auth loading. With all routes listed here, one pass at boot
      // discovers everything and no subsequent reload fires.
      entries: ['./src/client.tsx', './src/routes/**/*.tsx'],
      // The rule editor's engine is WebAssembly, found next to its own script. Pre-bundled,
      // the script moves to Vite's cache and the .wasm does not stay beside it, so the dev
      // server answers the request with HTML and the editor quietly drops to its
      // developer view — no pick-lists, no operators. Left where it is, it loads.
      // (It is a direct dependency so the pre-bundled editor can still resolve it.)
      exclude: ['@gorules/zen-engine-wasm'],
      // Monaco's workers, pre-bundled at start. Found only when a code box first opens — a
      // function node's body, say — Vite optimised them then and reloaded the page, which
      // threw away whatever the author had typed into the rule before saving it.
      // Pre-include all packages Vite would otherwise discover lazily on first
      // page load, which causes repeated reload loops that make the app appear
      // to hang in the browser. Everything here is a direct dependency; adding
      // it means one optimisation pass on first start rather than three or more.
      include: [
        'monaco-editor/editor/editor.worker',
        'monaco-editor/language/typescript/ts.worker',
        'monaco-editor/language/json/json.worker',
        '@tanstack/start',
        'react-dom/client',
        '@tanstack/react-router',
        'sonner',
        'lucide-react',
        '@tanstack/react-query',
        '@tanstack/react-query-devtools',
        '@radix-ui/react-dialog',
        '@tanstack/react-db',
        '@tanstack/electric-db-collection',
        'clsx',
        'tailwind-merge',
        'class-variance-authority',
        '@radix-ui/react-scroll-area',
        '@radix-ui/react-tooltip',
        '@radix-ui/react-avatar',
        '@radix-ui/react-dropdown-menu',
        '@radix-ui/react-checkbox',
        '@radix-ui/react-label',
        'react/jsx-dev-runtime',
        'react',
      ],
    },
    esbuild: {
      jsx: 'automatic',
      jsxImportSource: 'react',
    },
    resolve: {
      alias: {
        '@': path.resolve('./src'),
      },
    },
    // @ts-expect-error - server proxy is valid Vite config but not typed in StartUserViteConfig
    server: {
      proxy: {
        '/api': {
          target: process.env.VITE_API_URL || '{{config.baseUrl}}',
          changeOrigin: true,
          configure: (proxy: any) => {
            proxy.on('error', (_err: Error, req: any, res: any) => {
              if (res.headersSent) return
              const isAuth = (req.url as string)?.includes('/auth/')
              if (isAuth) {
                res.writeHead(200, { 'Content-Type': 'application/json' })
                res.end(JSON.stringify({ user: null, session: null }))
              } else {
                res.writeHead(503, { 'Content-Type': 'application/json' })
                res.end(JSON.stringify({ error: 'Backend unavailable' }))
              }
            })
          },
        },
      },
    },
  },
})
