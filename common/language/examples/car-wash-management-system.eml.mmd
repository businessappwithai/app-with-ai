%%report condition-images-by-phase title: Vehicle condition evidence by phase chart: bar x: phase y: total help: Claims staff verify whether photographs were taken before washing, afterward or at recovery. sql: SELECT ce.phase AS phase, COUNT(*) AS total FROM bus_condition_evidence ce  WHERE ce.deleted_at IS NULL GROUP BY ce.phase
%%report condition-images-by-employee title: Condition photographs recorded per employee chart: bar x: employee y: total help: Quality leads audit traceability of images captured by the team. sql: SELECT ce.employee_id AS employee, COUNT(*) AS total FROM bus_condition_evidence ce  WHERE ce.deleted_at IS NULL GROUP BY ce.employee_id
%%report evidence-holds-pending title: Condition evidence retained for review chart: bar x: retention y: total help: Compliance leads review whether potentially relevant images have a recorded retention plan. sql: SELECT COALESCE(ce.retention_until::text, 'indefinite') AS retention, COUNT(*) AS total FROM bus_condition_evidence ce  WHERE ce.deleted_at IS NULL GROUP BY COALESCE(ce.retention_until::text, 'indefinite')
%%report additional-work-by-status title: Additional work requests by authorization state chart: bar x: status y: total help: Customer service identifies extras awaiting an explicit customer decision. sql: SELECT a.status AS status, COUNT(*) AS total FROM bus_additional_work_approval a  WHERE a.deleted_at IS NULL GROUP BY a.status
%%report additional-quoted-value-by-state title: Additional service value by authorization chart: bar x: status y: value help: Finance reviews authorized additional revenue separately from refused requests. sql: SELECT a.status AS status, SUM(a.quoted_amount) AS value FROM bus_additional_work_approval a  WHERE a.deleted_at IS NULL GROUP BY a.status
%%report additional-work-by-service title: Extra work requested by service chart: bar x: service y: total help: Service managers review commonly proposed additions and whether package design needs adjustment. sql: SELECT a.service_id AS service, COUNT(*) AS total FROM bus_additional_work_approval a  WHERE a.deleted_at IS NULL GROUP BY a.service_id
%%report checklist-outcomes title: Shift checklists by observed result chart: bar x: outcome y: total help: Site management identifies failed start-of-shift safety checks. sql: SELECT sc.outcome AS outcome, COUNT(*) AS total FROM bus_site_checklist sc  WHERE sc.deleted_at IS NULL GROUP BY sc.outcome
%%report checklist-kinds title: Completed operational checks by type chart: bar x: kind y: total help: Operations checks coverage of required opening and closing procedures. sql: SELECT sc.kind AS kind, COUNT(*) AS total FROM bus_site_checklist sc  WHERE sc.deleted_at IS NULL GROUP BY sc.kind
%%report failed-checklists-by-site title: Safety checklist failures per location chart: bar x: site y: total help: Safety leads prioritize sites reporting readiness failures. sql: SELECT sc.site_id AS site, COUNT(*) AS total FROM bus_site_checklist sc  WHERE sc.deleted_at IS NULL AND sc.outcome = 'fail' GROUP BY sc.site_id
%%report checklist-unsafe-stop title: Emergency stop tests not passed by site chart: bar x: site y: total help: Technical teams escalate missing emergency-stop verification before operation. sql: SELECT sc.site_id AS site, COUNT(*) AS total FROM bus_site_checklist sc  WHERE sc.deleted_at IS NULL AND sc.emergency_stop_tested = false GROUP BY sc.site_id
%%report permits-by-result title: Environmental permits by standing chart: bar x: standing y: total help: Compliance staff review permits needing renewal or regulator follow-up. sql: SELECT ep.permit_result AS standing, COUNT(*) AS total FROM bus_environmental_permit ep  WHERE ep.deleted_at IS NULL GROUP BY ep.permit_result
%%report permits-expiring-by-site title: Environmental permits expiring in 60 days chart: bar x: site y: total help: Location management starts renewal before an operating permit expires. sql: SELECT ep.site_id AS site, COUNT(*) AS total FROM bus_environmental_permit ep  WHERE ep.deleted_at IS NULL AND ep.expires_on <= CURRENT_DATE + INTERVAL '60 days' GROUP BY ep.site_id
%%report wastewater-results title: Wastewater test outcomes chart: bar x: result y: total help: Environmental leads monitor exceedances against permit-specific limits. sql: SELECT es.result AS result, COUNT(*) AS total FROM bus_effluent_sample es  WHERE es.deleted_at IS NULL GROUP BY es.result
%%report wastewater-ph-by-site title: Measured mean wastewater pH by site chart: bar x: site y: avg_ph help: Operators examine pH drift and investigate conditions outside permit requirements. sql: SELECT es.site_id AS site, AVG(es.ph) AS avg_ph FROM bus_effluent_sample es  WHERE es.deleted_at IS NULL GROUP BY es.site_id
%%report wastewater-solids-by-site title: Measured suspended solids by site chart: bar x: site y: avg_tss help: Treatment engineers compare sampled solids concentrations across sites. sql: SELECT es.site_id AS site, AVG(es.suspended_solids_mg_l) AS avg_tss FROM bus_effluent_sample es  WHERE es.deleted_at IS NULL GROUP BY es.site_id
%%report wastewater-oil-by-site title: Measured wastewater oil and grease by site chart: bar x: site y: avg_oil help: Environmental teams find sites needing grease separation improvements. sql: SELECT es.site_id AS site, AVG(es.oil_grease_mg_l) AS avg_oil FROM bus_effluent_sample es  WHERE es.deleted_at IS NULL GROUP BY es.site_id
%%report waste-exit-by-type title: Waste disposed by material class chart: bar x: category y: kilograms help: Managers confirm the mix and mass of removed waste streams. sql: SELECT wd.category AS category, SUM(wd.quantity_kg) AS kilograms FROM bus_waste_disposal wd  WHERE wd.deleted_at IS NULL GROUP BY wd.category
%%report waste-exit-by-site title: Disposal quantity by site chart: bar x: site y: kilograms help: Site supervisors reconcile manifest quantities with collection records. sql: SELECT wd.site_id AS site, SUM(wd.quantity_kg) AS kilograms FROM bus_waste_disposal wd  WHERE wd.deleted_at IS NULL GROUP BY wd.site_id
%%report fleet-accounts-by-cycle title: Fleet accounts by billing cadence chart: bar x: cycle y: total help: Account staff plan invoicing workload and customer statement cycles. sql: SELECT fa.billing_cycle AS cycle, COUNT(*) AS total FROM bus_fleet_account fa  WHERE fa.deleted_at IS NULL GROUP BY fa.billing_cycle
%%report fleet-credit-by-cycle title: Contracted fleet credit exposure by cycle chart: bar x: cycle y: limit_total help: Credit control reviews authorized exposure by billing cycle. sql: SELECT fa.billing_cycle AS cycle, SUM(fa.credit_limit) AS limit_total FROM bus_fleet_account fa  WHERE fa.deleted_at IS NULL GROUP BY fa.billing_cycle
%%report fleet-invoices-by-status title: Consolidated fleet invoices by state chart: bar x: status y: total help: Collections identifies issued, overdue and partly paid fleet statements. sql: SELECT fi.status AS status, COUNT(*) AS total FROM bus_fleet_invoice fi  WHERE fi.deleted_at IS NULL GROUP BY fi.status
%%report fleet-receivable-by-status title: Fleet outstanding amount by invoice state chart: bar x: status y: receivable help: Finance ranks unresolved business account receivables. sql: SELECT fi.status AS status, SUM(fi.total_amount - fi.amount_paid) AS receivable FROM bus_fleet_invoice fi  WHERE fi.deleted_at IS NULL GROUP BY fi.status
%%report fleet-billed-by-site title: Fleet invoice value by billing location chart: bar x: site y: billed help: Branch management reviews fleet revenue concentrated at each location. sql: SELECT fi.site_id AS site, SUM(fi.total_amount) AS billed FROM bus_fleet_invoice fi  WHERE fi.deleted_at IS NULL GROUP BY fi.site_id
%%report payment-attempt-outcomes title: Processor payment attempts by result chart: bar x: result y: attempts help: Finance separates settlement successes from retries and processor failures. sql: SELECT pa.result AS result, COUNT(*) AS attempts FROM bus_payment_attempt pa  WHERE pa.deleted_at IS NULL GROUP BY pa.result
%%report payment-attempt-value title: Payment attempt value by outcome chart: bar x: result y: amount_total help: Collections compares amounts attempted with genuine successful settlement. sql: SELECT pa.result AS result, SUM(pa.amount) AS amount_total FROM bus_payment_attempt pa  WHERE pa.deleted_at IS NULL GROUP BY pa.result
%%report membership-renewal-results title: Subscription renewal results chart: bar x: result y: total help: Membership staff identify members needing retry or manual intervention. sql: SELECT mb.result AS result, COUNT(*) AS total FROM bus_membership_billing_event mb  WHERE mb.deleted_at IS NULL GROUP BY mb.result
%%report membership-retry-load title: Subscription retries required by outcome chart: bar x: result y: retries help: Billing teams track operational burden from payment retries. sql: SELECT mb.result AS result, SUM(mb.retry_count) AS retries FROM bus_membership_billing_event mb  WHERE mb.deleted_at IS NULL GROUP BY mb.result
%%report customer-feedback-by-channel title: Customer responses by channel chart: bar x: channel y: total help: Service managers monitor which feedback channels customers actually use. sql: SELECT cf.channel AS channel, COUNT(*) AS total FROM bus_customer_feedback cf  WHERE cf.deleted_at IS NULL GROUP BY cf.channel
%%report customer-recovery-outcomes title: Service recovery actions by result chart: bar x: outcome y: total help: Customer experience teams see whether promises led to completed recoveries. sql: SELECT cf.recovery_outcome AS outcome, COUNT(*) AS total FROM bus_customer_feedback cf  WHERE cf.deleted_at IS NULL GROUP BY cf.recovery_outcome
%%report customer-ratings-by-channel title: Customer satisfaction by feedback channel chart: bar x: channel y: average_rating help: Customer experience leads compare satisfaction from different contact channels. sql: SELECT cf.channel AS channel, AVG(cf.rating) AS average_rating FROM bus_customer_feedback cf  WHERE cf.deleted_at IS NULL GROUP BY cf.channel
