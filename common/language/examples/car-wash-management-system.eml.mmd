%%report sales-by-site title: Sales value by site chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, SUM(w.grand_total) AS total FROM bus_work_order w JOIN bus_site s ON w.site_id = s.id WHERE w.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report orders-by-site title: Work orders by site chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_work_order w JOIN bus_site s ON w.site_id = s.id WHERE w.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report sales-by-month title: Sales value by month chart: line x: month y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT DATE_TRUNC('month', w.opened_at) AS month, SUM(w.grand_total) AS total FROM bus_work_order w WHERE w.deleted_at IS NULL GROUP BY DATE_TRUNC('month', w.opened_at)
%%report orders-by-month title: Work orders by month chart: line x: month y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT DATE_TRUNC('month', w.opened_at) AS month, COUNT(*) AS total FROM bus_work_order w WHERE w.deleted_at IS NULL GROUP BY DATE_TRUNC('month', w.opened_at)
%%report average-ticket-by-site title: Average ticket by site chart: bar x: site y: average_total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, AVG(w.grand_total) AS average_total FROM bus_work_order w JOIN bus_site s ON w.site_id = s.id WHERE w.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report discount-rate-by-site title: Discount value by site chart: bar x: site y: discount_total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, SUM(w.discount_total) AS discount_total FROM bus_work_order w JOIN bus_site s ON w.site_id = s.id WHERE w.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report tax-collected-by-site title: Tax collected by site chart: bar x: site y: tax_total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, SUM(w.tax_total) AS tax_total FROM bus_work_order w JOIN bus_site s ON w.site_id = s.id WHERE w.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report orders-by-status title: Work orders by status chart: bar x: status y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT w.status AS status, COUNT(*) AS total FROM bus_work_order w WHERE w.deleted_at IS NULL GROUP BY w.status
%%report delayed-open-orders title: Open orders past promise chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_work_order w JOIN bus_site s ON w.site_id = s.id WHERE w.deleted_at IS NULL AND s.deleted_at IS NULL AND w.completed_at IS NULL AND w.promised_at < CURRENT_TIMESTAMP GROUP BY s.name
%%report completion-minutes-by-site title: Average completion minutes by site chart: bar x: site y: minutes help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, AVG(EXTRACT(EPOCH FROM (w.completed_at - w.opened_at))/60) AS minutes FROM bus_work_order w JOIN bus_site s ON w.site_id = s.id WHERE w.deleted_at IS NULL AND s.deleted_at IS NULL AND w.completed_at IS NOT NULL GROUP BY s.name
%%report service-revenue-ranking title: Revenue by service chart: bar x: service y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS service, SUM(l.line_total) AS total FROM bus_work_order_line l JOIN bus_service s ON l.service_id = s.id WHERE l.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report service-volume-ranking title: Units sold by service chart: bar x: service y: quantity help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS service, SUM(l.quantity) AS quantity FROM bus_work_order_line l JOIN bus_service s ON l.service_id = s.id WHERE l.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report service-discount-ranking title: Discounts by service chart: bar x: service y: discount help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS service, SUM(l.discount_amount) AS discount FROM bus_work_order_line l JOIN bus_service s ON l.service_id = s.id WHERE l.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report customers-by-type title: Customers by relationship type chart: pie x: customer_type y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT c.customer_type AS customer_type, COUNT(*) AS total FROM bus_customer c WHERE c.deleted_at IS NULL GROUP BY c.customer_type
%%report vehicles-by-type title: Vehicles by body type chart: bar x: vehicle_type y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT v.vehicle_type AS vehicle_type, COUNT(*) AS total FROM bus_vehicle v WHERE v.deleted_at IS NULL GROUP BY v.vehicle_type
%%report new-customers-by-month title: New customers by month chart: line x: month y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT DATE_TRUNC('month', c.created_at) AS month, COUNT(*) AS total FROM bus_customer c WHERE c.deleted_at IS NULL GROUP BY DATE_TRUNC('month', c.created_at)
%%report loyalty-points-by-type title: Loyalty points by movement type chart: bar x: entry_type y: points help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT l.entry_type AS entry_type, SUM(l.points) AS points FROM bus_loyalty_entry l WHERE l.deleted_at IS NULL GROUP BY l.entry_type
%%report loyalty-adjustments-by-employee title: Manual loyalty activity by employee chart: bar x: employee y: points help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT e.full_name AS employee, SUM(l.points) AS points FROM bus_loyalty_entry l JOIN bus_employee e ON l.employee_id = e.id WHERE l.deleted_at IS NULL AND e.deleted_at IS NULL GROUP BY e.full_name
%%report memberships-by-status title: Memberships by status chart: bar x: status y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT m.status AS status, COUNT(*) AS total FROM bus_membership m WHERE m.deleted_at IS NULL GROUP BY m.status
%%report memberships-by-plan title: Memberships by plan chart: bar x: plan y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT p.name AS plan, COUNT(*) AS total FROM bus_membership m JOIN bus_membership_plan p ON m.membership_plan_id = p.id WHERE m.deleted_at IS NULL AND p.deleted_at IS NULL GROUP BY p.name
%%report membership-renewals-due title: Membership renewals due by date chart: line x: billing_date y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT m.next_billing_date AS billing_date, COUNT(*) AS total FROM bus_membership m WHERE m.deleted_at IS NULL AND m.next_billing_date IS NOT NULL GROUP BY m.next_billing_date
%%report membership-past-due-by-plan title: Past-due memberships by plan chart: bar x: plan y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT p.name AS plan, COUNT(*) AS total FROM bus_membership m JOIN bus_membership_plan p ON m.membership_plan_id = p.id WHERE m.deleted_at IS NULL AND p.deleted_at IS NULL AND m.status = 'past_due' GROUP BY p.name
%%report bookings-by-status title: Bookings by status chart: bar x: status y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT b.status AS status, COUNT(*) AS total FROM bus_booking b WHERE b.deleted_at IS NULL GROUP BY b.status
%%report bookings-by-site title: Bookings by site chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_booking b JOIN bus_site s ON b.site_id = s.id WHERE b.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report bookings-by-source title: Bookings by source chart: bar x: source y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT b.source AS source, COUNT(*) AS total FROM bus_booking b WHERE b.deleted_at IS NULL GROUP BY b.source
%%report no-shows-by-site title: No-shows by site chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_booking b JOIN bus_site s ON b.site_id = s.id WHERE b.deleted_at IS NULL AND s.deleted_at IS NULL AND b.status = 'no_show' GROUP BY s.name
%%report booking-lead-hours title: Average booking lead hours by site chart: bar x: site y: hours help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, AVG(EXTRACT(EPOCH FROM (b.scheduled_start - b.created_at))/3600) AS hours FROM bus_booking b JOIN bus_site s ON b.site_id = s.id WHERE b.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report queue-arrivals-by-site title: Queue arrivals by site chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_queue_ticket q JOIN bus_site s ON q.site_id = s.id WHERE q.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report queue-wait-by-site title: Quoted wait by site chart: bar x: site y: minutes help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, AVG(q.estimated_wait_minutes) AS minutes FROM bus_queue_ticket q JOIN bus_site s ON q.site_id = s.id WHERE q.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report queue-abandonment-by-site title: Queue abandonment by site chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_queue_ticket q JOIN bus_site s ON q.site_id = s.id WHERE q.deleted_at IS NULL AND s.deleted_at IS NULL AND q.status = 'left' GROUP BY s.name
%%report payments-by-method title: Captured value by payment method chart: pie x: method y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT p.method AS method, SUM(p.amount) AS total FROM bus_payment p WHERE p.deleted_at IS NULL AND p.status = 'captured' GROUP BY p.method
%%report payments-by-status title: Payments by processing status chart: bar x: status y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT p.status AS status, COUNT(*) AS total FROM bus_payment p WHERE p.deleted_at IS NULL GROUP BY p.status
%%report refund-value-by-method title: Refund value by payment method chart: bar x: method y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT p.method AS method, SUM(ABS(p.amount)) AS total FROM bus_payment p WHERE p.deleted_at IS NULL AND p.amount < 0 GROUP BY p.method
%%report failed-payments-by-day title: Failed payments by day chart: line x: day y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT DATE_TRUNC('day', p.processed_at) AS day, COUNT(*) AS total FROM bus_payment p WHERE p.deleted_at IS NULL AND p.status = 'failed' GROUP BY DATE_TRUNC('day', p.processed_at)
%%report cash-variance-by-site title: Cash variance by site chart: bar x: site y: variance help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, SUM(c.variance) AS variance FROM bus_cash_shift c JOIN bus_site s ON c.site_id = s.id WHERE c.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report cash-variance-by-employee title: Cash variance by cashier chart: bar x: employee y: variance help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT e.full_name AS employee, SUM(c.variance) AS variance FROM bus_cash_shift c JOIN bus_employee e ON c.employee_id = e.id WHERE c.deleted_at IS NULL AND e.deleted_at IS NULL GROUP BY e.full_name
%%report open-cash-shifts-by-site title: Open cash shifts by site chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_cash_shift c JOIN bus_site s ON c.site_id = s.id WHERE c.deleted_at IS NULL AND s.deleted_at IS NULL AND c.status = 'open' GROUP BY s.name
%%report stock-value-by-site title: Stock value by site chart: bar x: site y: value help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, SUM(st.quantity_on_hand * i.standard_cost) AS value FROM bus_inventory_stock st JOIN bus_site s ON st.site_id = s.id JOIN bus_inventory_item i ON st.inventory_item_id = i.id WHERE st.deleted_at IS NULL AND s.deleted_at IS NULL AND i.deleted_at IS NULL GROUP BY s.name
%%report low-stock-items-by-site title: Items at or below reorder level chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_inventory_stock st JOIN bus_site s ON st.site_id = s.id WHERE st.deleted_at IS NULL AND s.deleted_at IS NULL AND st.quantity_on_hand <= st.reorder_level GROUP BY s.name
%%report overstock-items-by-site title: Items above maximum level chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_inventory_stock st JOIN bus_site s ON st.site_id = s.id WHERE st.deleted_at IS NULL AND s.deleted_at IS NULL AND st.maximum_level IS NOT NULL AND st.quantity_on_hand > st.maximum_level GROUP BY s.name
%%report chemical-consumption-by-site title: Chemical consumption by site chart: bar x: site y: quantity help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, SUM(ABS(t.quantity)) AS quantity FROM bus_inventory_transaction t JOIN bus_inventory_stock st ON t.inventory_stock_id = st.id JOIN bus_site s ON st.site_id = s.id JOIN bus_inventory_item i ON st.inventory_item_id = i.id WHERE t.deleted_at IS NULL AND st.deleted_at IS NULL AND s.deleted_at IS NULL AND i.deleted_at IS NULL AND i.category = 'chemical' AND t.movement_type = 'consumption' GROUP BY s.name
%%report inventory-adjustments-by-site title: Inventory adjustments by site chart: bar x: site y: quantity help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, SUM(ABS(t.quantity)) AS quantity FROM bus_inventory_transaction t JOIN bus_inventory_stock st ON t.inventory_stock_id = st.id JOIN bus_site s ON st.site_id = s.id WHERE t.deleted_at IS NULL AND st.deleted_at IS NULL AND s.deleted_at IS NULL AND t.movement_type = 'adjustment' GROUP BY s.name
%%report purchase-orders-by-status title: Purchase orders by status chart: bar x: status y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT p.status AS status, COUNT(*) AS total FROM bus_purchase_order p WHERE p.deleted_at IS NULL GROUP BY p.status
%%report purchase-value-by-vendor title: Purchase value by vendor chart: bar x: vendor y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT v.name AS vendor, SUM(p.total_amount) AS total FROM bus_purchase_order p JOIN bus_vendor v ON p.vendor_id = v.id WHERE p.deleted_at IS NULL AND v.deleted_at IS NULL GROUP BY v.name
%%report late-purchase-orders-by-vendor title: Late open purchase orders by vendor chart: bar x: vendor y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT v.name AS vendor, COUNT(*) AS total FROM bus_purchase_order p JOIN bus_vendor v ON p.vendor_id = v.id WHERE p.deleted_at IS NULL AND v.deleted_at IS NULL AND p.expected_on < CURRENT_DATE AND p.status NOT IN ('received','cancelled') GROUP BY v.name
%%report purchase-receipt-gap-by-item title: Unreceived quantity by inventory item chart: bar x: item y: quantity help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT i.name AS item, SUM(l.ordered_quantity - l.received_quantity) AS quantity FROM bus_purchase_order_line l JOIN bus_inventory_item i ON l.inventory_item_id = i.id WHERE l.deleted_at IS NULL AND i.deleted_at IS NULL GROUP BY i.name
%%report equipment-by-status title: Equipment by operating status chart: bar x: status y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT e.status AS status, COUNT(*) AS total FROM bus_equipment e WHERE e.deleted_at IS NULL GROUP BY e.status
%%report equipment-by-type title: Equipment by type chart: bar x: equipment_type y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT e.equipment_type AS equipment_type, COUNT(*) AS total FROM bus_equipment e WHERE e.deleted_at IS NULL GROUP BY e.equipment_type
%%report maintenance-due-by-site title: Equipment due for service by site chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_equipment e JOIN bus_site s ON e.site_id = s.id WHERE e.deleted_at IS NULL AND s.deleted_at IS NULL AND e.next_service_date <= CURRENT_DATE GROUP BY s.name
%%report maintenance-cost-by-equipment title: Maintenance cost by equipment chart: bar x: equipment y: cost help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT e.name AS equipment, SUM(m.cost) AS cost FROM bus_equipment_maintenance m JOIN bus_equipment e ON m.equipment_id = e.id WHERE m.deleted_at IS NULL AND e.deleted_at IS NULL GROUP BY e.name
%%report downtime-by-equipment title: Downtime minutes by equipment chart: bar x: equipment y: minutes help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT e.name AS equipment, SUM(m.downtime_minutes) AS minutes FROM bus_equipment_maintenance m JOIN bus_equipment e ON m.equipment_id = e.id WHERE m.deleted_at IS NULL AND e.deleted_at IS NULL GROUP BY e.name
%%report maintenance-by-status title: Maintenance work by status chart: bar x: status y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT m.status AS status, COUNT(*) AS total FROM bus_equipment_maintenance m WHERE m.deleted_at IS NULL GROUP BY m.status
%%report incidents-by-severity title: Incidents by severity chart: pie x: severity y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT i.severity AS severity, COUNT(*) AS total FROM bus_incident i WHERE i.deleted_at IS NULL GROUP BY i.severity
%%report incidents-by-type title: Incidents by type chart: bar x: incident_type y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT i.incident_type AS incident_type, COUNT(*) AS total FROM bus_incident i WHERE i.deleted_at IS NULL GROUP BY i.incident_type
%%report open-incidents-by-site title: Unresolved incidents by site chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_incident i JOIN bus_site s ON i.site_id = s.id WHERE i.deleted_at IS NULL AND s.deleted_at IS NULL AND i.resolved_at IS NULL GROUP BY s.name
%%report critical-incidents-by-month title: Critical incidents by month chart: line x: month y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT DATE_TRUNC('month', i.occurred_at) AS month, COUNT(*) AS total FROM bus_incident i WHERE i.deleted_at IS NULL AND i.severity = 'critical' GROUP BY DATE_TRUNC('month', i.occurred_at)
%%report water-input-by-site title: Water input readings by site chart: bar x: site y: value help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, SUM(u.reading_value) AS value FROM bus_utility_reading u JOIN bus_site s ON u.site_id = s.id WHERE u.deleted_at IS NULL AND s.deleted_at IS NULL AND u.meter_type = 'water_input' GROUP BY s.name
%%report water-reclaimed-by-site title: Reclaimed water readings by site chart: bar x: site y: value help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, SUM(u.reading_value) AS value FROM bus_utility_reading u JOIN bus_site s ON u.site_id = s.id WHERE u.deleted_at IS NULL AND s.deleted_at IS NULL AND u.meter_type = 'water_reclaimed' GROUP BY s.name
%%report energy-readings-by-site title: Electricity readings by site chart: bar x: site y: value help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, SUM(u.reading_value) AS value FROM bus_utility_reading u JOIN bus_site s ON u.site_id = s.id WHERE u.deleted_at IS NULL AND s.deleted_at IS NULL AND u.meter_type = 'electricity' GROUP BY s.name
%%report utility-cost-by-site title: Utility period cost by site chart: bar x: site y: cost help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, SUM(u.period_cost) AS cost FROM bus_utility_reading u JOIN bus_site s ON u.site_id = s.id WHERE u.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report employee-workload title: Work orders led by employee chart: bar x: employee y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT e.full_name AS employee, COUNT(*) AS total FROM bus_work_order w JOIN bus_employee e ON w.employee_id = e.id WHERE w.deleted_at IS NULL AND e.deleted_at IS NULL GROUP BY e.full_name
%%report employee-completion-value title: Completed value by employee chart: bar x: employee y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT e.full_name AS employee, SUM(w.grand_total) AS total FROM bus_work_order w JOIN bus_employee e ON w.employee_id = e.id WHERE w.deleted_at IS NULL AND e.deleted_at IS NULL AND w.status = 'completed' GROUP BY e.full_name
%%report inspections-by-employee title: Vehicle inspections by employee chart: bar x: employee y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT e.full_name AS employee, COUNT(*) AS total FROM bus_vehicle_inspection i JOIN bus_employee e ON i.employee_id = e.id WHERE i.deleted_at IS NULL AND e.deleted_at IS NULL GROUP BY e.full_name
%%report preexisting-damage-by-site title: Pre-existing damage records by site chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_vehicle_inspection i JOIN bus_work_order w ON i.work_order_id = w.id JOIN bus_site s ON w.site_id = s.id WHERE i.deleted_at IS NULL AND w.deleted_at IS NULL AND s.deleted_at IS NULL AND i.pre_existing_damage = TRUE GROUP BY s.name
%%report promotion-discount-by-code title: Discount value by promotion code chart: bar x: promotion y: discount help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT p.code AS promotion, SUM(l.discount_amount) AS discount FROM bus_work_order_line l JOIN bus_promotion p ON l.promotion_id = p.id WHERE l.deleted_at IS NULL AND p.deleted_at IS NULL GROUP BY p.code
%%report active-promotions-by-site title: Active promotions by site chart: bar x: site y: total help: Management and operating roles use this result to identify the condition, assign action, and verify improvement. sql: SELECT COALESCE(s.name, 'All sites') AS site, COUNT(*) AS total FROM bus_promotion p LEFT JOIN bus_site s ON p.site_id = s.id WHERE p.deleted_at IS NULL AND p.status = 'active' GROUP BY COALESCE(s.name, 'All sites')
%%report wash-bay-capacity-by-site title: Wash bay vehicle capacity by site chart: bar x: site y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT s.name AS site, SUM(b.capacity_vehicles) AS total FROM bus_wash_bay b JOIN bus_site s ON b.site_id = s.id WHERE b.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report wash-bays-by-status title: Wash bays by availability status chart: bar x: status y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT b.status AS status, COUNT(*) AS total FROM bus_wash_bay b WHERE b.deleted_at IS NULL GROUP BY b.status
%%report bay-allocations-by-site title: Scheduled bay allocations by site chart: bar x: site y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_bay_allocation a JOIN bus_wash_bay b ON a.wash_bay_id = b.id JOIN bus_site s ON b.site_id = s.id WHERE a.deleted_at IS NULL AND b.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report bay-allocations-by-status title: Bay allocations by progress state chart: bar x: status y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT a.status AS status, COUNT(*) AS total FROM bus_bay_allocation a WHERE a.deleted_at IS NULL GROUP BY a.status
%%report bay-booked-minutes-by-location title: Reserved bay minutes by site chart: bar x: site y: minutes help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT s.name AS site, SUM(EXTRACT(EPOCH FROM (a.planned_end - a.planned_start))/60) AS minutes FROM bus_bay_allocation a JOIN bus_wash_bay b ON a.wash_bay_id = b.id JOIN bus_site s ON b.site_id = s.id WHERE a.deleted_at IS NULL AND b.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report bay-actual-minutes-by-location title: Actual occupied bay minutes by site chart: bar x: site y: minutes help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT s.name AS site, SUM(EXTRACT(EPOCH FROM (a.actual_end - a.actual_start))/60) AS minutes FROM bus_bay_allocation a JOIN bus_wash_bay b ON a.wash_bay_id = b.id JOIN bus_site s ON b.site_id = s.id WHERE a.deleted_at IS NULL AND b.deleted_at IS NULL AND s.deleted_at IS NULL AND a.actual_end IS NOT NULL AND a.actual_start IS NOT NULL GROUP BY s.name
%%report damage-claims-by-status title: Customer damage claims by resolution state chart: bar x: status y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT c.status AS status, COUNT(*) AS total FROM bus_damage_claim c WHERE c.deleted_at IS NULL GROUP BY c.status
%%report damage-claimed-value-by-month title: Damage amount claimed per month chart: line x: month y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT DATE_TRUNC('month', c.reported_at) AS month, SUM(c.claimed_amount) AS total FROM bus_damage_claim c WHERE c.deleted_at IS NULL GROUP BY DATE_TRUNC('month', c.reported_at)
%%report damage-approved-value-by-month title: Approved claim settlement by month chart: line x: month y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT DATE_TRUNC('month', c.reported_at) AS month, SUM(c.approved_amount) AS total FROM bus_damage_claim c WHERE c.deleted_at IS NULL AND c.approved_amount IS NOT NULL GROUP BY DATE_TRUNC('month', c.reported_at)
%%report damage-claims-by-vehicle-type title: Claims by vehicle body type chart: bar x: vehicle_type y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT v.vehicle_type AS vehicle_type, COUNT(*) AS total FROM bus_damage_claim c JOIN bus_vehicle v ON c.vehicle_id = v.id WHERE c.deleted_at IS NULL AND v.deleted_at IS NULL GROUP BY v.vehicle_type
%%report refund-requests-by-status title: Customer refunds by approval stage chart: bar x: status y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT r.status AS status, COUNT(*) AS total FROM bus_refund_request r WHERE r.deleted_at IS NULL GROUP BY r.status
%%report refund-requests-by-month title: Refund requests raised each month chart: line x: month y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT DATE_TRUNC('month', r.requested_at) AS month, COUNT(*) AS total FROM bus_refund_request r WHERE r.deleted_at IS NULL GROUP BY DATE_TRUNC('month', r.requested_at)
%%report refund-amount-requested-by-month title: Requested refund amount by month chart: line x: month y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT DATE_TRUNC('month', r.requested_at) AS month, SUM(r.requested_amount) AS total FROM bus_refund_request r WHERE r.deleted_at IS NULL GROUP BY DATE_TRUNC('month', r.requested_at)
%%report refund-approved-by-employee title: Refund value approved by reviewer chart: bar x: reviewer y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT e.full_name AS reviewer, SUM(r.approved_amount) AS total FROM bus_refund_request r JOIN bus_employee e ON r.approved_by_id = e.id WHERE r.deleted_at IS NULL AND e.deleted_at IS NULL GROUP BY e.full_name
%%report chemical-checks-by-result title: Chemical safety check outcomes chart: bar x: result y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT c.result AS result, COUNT(*) AS total FROM bus_chemical_safety_check c WHERE c.deleted_at IS NULL GROUP BY c.result
%%report chemical-checks-by-site title: Chemical safety inspections by site chart: bar x: site y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_chemical_safety_check c JOIN bus_site s ON c.site_id = s.id WHERE c.deleted_at IS NULL AND s.deleted_at IS NULL GROUP BY s.name
%%report open-chemical-remediation-by-site title: Unclosed chemical safety findings by location chart: bar x: site y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_chemical_safety_check c JOIN bus_site s ON c.site_id = s.id WHERE c.deleted_at IS NULL AND s.deleted_at IS NULL AND c.status IN ('open', 'remediation_required') GROUP BY s.name
%%report overdue-chemical-corrections-by-site title: Chemical corrective actions past due by site chart: bar x: site y: total help: Site management reviews this measure to assign responsibility, verify service quality, and close exceptions with evidence. sql: SELECT s.name AS site, COUNT(*) AS total FROM bus_chemical_safety_check c JOIN bus_site s ON c.site_id = s.id WHERE c.deleted_at IS NULL AND s.deleted_at IS NULL AND c.corrective_due_on < CURRENT_DATE AND c.status NOT IN ('verified', 'closed') GROUP BY s.name
