# Written by scripts/install-into.ts, once. Never regenerate CHAT_BRIDGE_SECRET: it signs the
# delegated reporting sign-in and the embed cookie, and the three services must share it.
CHAT_BRIDGE_SECRET=
PUBLIC_ORIGIN=http://localhost:4080
GATEWAY_PORT=4080
# Any OpenAI-compatible endpoint whose model supports tool calling.
AI_BASE_URL=http://host.docker.internal:8000/v1
AI_MODEL=qwen3.6:27b-mlx
